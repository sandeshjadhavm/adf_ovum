{
	"name": "caovumtransformationdf",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "Excel1",
						"type": "DatasetReference"
					},
					"name": "azaleapatients"
				},
				{
					"name": "capateints"
				},
				{
					"name": "azaleaclaims"
				},
				{
					"name": "caclaims"
				},
				{
					"name": "azaleaappointments"
				},
				{
					"name": "caappointments"
				}
			],
			"sinks": [
				{
					"name": "sink1"
				},
				{
					"name": "sink2"
				},
				{
					"name": "sink3"
				}
			],
			"transformations": [
				{
					"name": "join1"
				},
				{
					"name": "join2"
				},
				{
					"name": "join3"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "alterRow1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "alterRow2"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "alterRow3"
				}
			],
			"scriptLines": [
				"source(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> azaleapatients",
				"source(allowSchemaDrift: true,",
				"     validateSchema: false) ~> capateints",
				"source(allowSchemaDrift: true,",
				"     validateSchema: false) ~> azaleaclaims",
				"source(allowSchemaDrift: true,",
				"     validateSchema: false) ~> caclaims",
				"source(allowSchemaDrift: true,",
				"     validateSchema: false) ~> azaleaappointments",
				"source(allowSchemaDrift: true,",
				"     validateSchema: false) ~> caappointments",
				"azaleapatients, capateints join(ERROR_FUNCTION('') == ERROR_FUNCTION(''),",
				"     joinType:'outer',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"azaleaclaims, caclaims join(ERROR_FUNCTION('') == ERROR_FUNCTION(''),",
				"     joinType:'outer',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join2",
				"azaleaappointments, caappointments join(ERROR_FUNCTION('') == ERROR_FUNCTION(''),",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join3",
				"join1 derive() ~> derivedColumn1",
				"derivedColumn1 alterRow() ~> alterRow1",
				"join2 derive() ~> derivedColumn2",
				"derivedColumn2 alterRow() ~> alterRow2",
				"join3 derive() ~> derivedColumn3",
				"derivedColumn3 alterRow() ~> alterRow3",
				"alterRow1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink1",
				"alterRow2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink2",
				"alterRow3 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink3"
			]
		}
	}
}