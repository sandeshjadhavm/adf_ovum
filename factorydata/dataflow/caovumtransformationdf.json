{
	"name": "caovumtransformationdf",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "AzaleaPatientData",
						"type": "DatasetReference"
					},
					"name": "azaleapatients"
				},
				{
					"name": "capateints"
				},
				{
					"dataset": {
						"referenceName": "AzaleaClaimData",
						"type": "DatasetReference"
					},
					"name": "azaleaclaims"
				},
				{
					"name": "caclaims"
				},
				{
					"dataset": {
						"referenceName": "AzaleaAppointmentData",
						"type": "DatasetReference"
					},
					"name": "azaleaappointments"
				},
				{
					"name": "caappointments"
				}
			],
			"sinks": [
				{
					"name": "sink1"
				},
				{
					"name": "sink2"
				},
				{
					"name": "sink3"
				}
			],
			"transformations": [
				{
					"name": "join1"
				},
				{
					"name": "join2"
				},
				{
					"name": "join3"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "alterRow1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "alterRow2"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "alterRow3"
				}
			],
			"scriptLines": [
				"source(output(",
				"          resourceType as string,",
				"          id as string,",
				"          meta_lastUpdated as string,",
				"          meta_profile as string,",
				"          extension as string,",
				"          identifier as string,",
				"          active as string,",
				"          name as string,",
				"          gender as string,",
				"          birthDate as string,",
				"          address as string,",
				"          generalPractitioner as string,",
				"          managingOrganization_reference as string,",
				"          managingOrganization_type as string,",
				"          managingOrganization_display as string,",
				"          telecom as string,",
				"          link as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> azaleapatients",
				"source(allowSchemaDrift: true,",
				"     validateSchema: false) ~> capateints",
				"source(output(",
				"          resourceType as string,",
				"          id as string,",
				"          meta_lastUpdated as string,",
				"          contained as string,",
				"          identifier as string,",
				"          status as string,",
				"          type_coding as string,",
				"          type_text as string,",
				"          use as string,",
				"          patient_reference as string,",
				"          patient_type as string,",
				"          patient_display as string,",
				"          billablePeriod_start as string,",
				"          billablePeriod_end as string,",
				"          created as string,",
				"          provider_reference as string,",
				"          provider_type as string,",
				"          provider_display as string,",
				"          priority_coding as string,",
				"          priority_text as string,",
				"          careTeam as string,",
				"          supportingInfo as string,",
				"          insurance as string,",
				"          facility_reference as string,",
				"          facility_type as string,",
				"          facility_display as string,",
				"          diagnosis as string,",
				"          procedure as string,",
				"          item as string,",
				"          total_value as string,",
				"          total_currency as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> azaleaclaims",
				"source(allowSchemaDrift: true,",
				"     validateSchema: false) ~> caclaims",
				"source(output(",
				"          resourceType as string,",
				"          id as string,",
				"          meta_lastUpdated as string,",
				"          identifier as string,",
				"          status as string,",
				"          appointmentType_coding as string,",
				"          appointmentType_text as string,",
				"          reasonCode as string,",
				"          start as string,",
				"          end as string,",
				"          minutesDuration as string,",
				"          created as string,",
				"          participant as string,",
				"          comment as string,",
				"          meta_profile as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> azaleaappointments",
				"source(allowSchemaDrift: true,",
				"     validateSchema: false) ~> caappointments",
				"azaleapatients, capateints join(ERROR_FUNCTION('') == ERROR_FUNCTION(''),",
				"     joinType:'outer',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"azaleaclaims, caclaims join(ERROR_FUNCTION('') == ERROR_FUNCTION(''),",
				"     joinType:'outer',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join2",
				"azaleaappointments, caappointments join(ERROR_FUNCTION('') == ERROR_FUNCTION(''),",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join3",
				"join1 derive() ~> derivedColumn1",
				"derivedColumn1 alterRow() ~> alterRow1",
				"join2 derive() ~> derivedColumn2",
				"derivedColumn2 alterRow() ~> alterRow2",
				"join3 derive() ~> derivedColumn3",
				"derivedColumn3 alterRow() ~> alterRow3",
				"alterRow1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink1",
				"alterRow2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink2",
				"alterRow3 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink3"
			]
		}
	}
}